FROM node:22-alpine AS build
WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN npm ci
COPY client/index.html client/vite.config.js ./
COPY client/src ./src
RUN npm run build
FROM node:22-alpine
WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY client/ws_bridge.js ./
COPY client/catalog.mjs ./
COPY client/baskets.mjs ./
COPY config/products.json /config/products.json
COPY --from=build /app/dist ./dist
USER node
CMD ["node", "ws_bridge.js"]
